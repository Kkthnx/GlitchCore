# Discord bot authentication
TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=your_dev_guild_id

# MongoDB connection string
MONGO_URI=your_mongodb_uri_here

# Optional services
STEAMGRIDDB_API_KEY=your_steamgriddb_key

# Optional: Twitch app credentials for streamer go-live notifications
# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Logging and environment
NODE_ENV=development
LOG_LEVEL=info

# Optional: register slash commands automatically on startup (default: on).
# Set to "false" to manage commands only via `npm run deploy`.
AUTO_DEPLOY=true
# Optional: channel ID to receive bot error alerts
ERROR_CHANNEL_ID=

# Channel IDs (kept out of the repo). Fill in the ones you use.
# leave/birthday fall back to welcome/announcements when blank.
WELCOME_CHANNEL_ID=
LEAVE_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
LFG_CHANNEL_ID=
LEVEL_UP_LOG_CHANNEL_ID=
MOD_LOG_CHANNEL_ID=
BIRTHDAY_CHANNEL_ID=
